# =====================================================================
# Graph-Based Fraud Intelligence - Environment Configuration Template
# =====================================================================
# Copy this file to .env and adjust variables as needed for your environment.

# Flask Application Settings
FLASK_APP=src.app:create_app
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
DATABASE_PATH=data/database/fraudgraph.db

# Machine Learning & Detection Engine Settings
ISOLATION_FOREST_CONTAMINATION=0.08
RANDOM_SEED=42
HIGH_AMOUNT_THRESHOLD=50000.0
STRUCTURING_MIN=8500.0
STRUCTURING_MAX=9999.0
RAPID_TX_WINDOW_SECONDS=900
RAPID_TX_MIN_COUNT=3

# Graph Engine Settings
DEFAULT_MAX_CYCLE_LENGTH=4
CYCLE_MIN_AMOUNT=1000.0
DEFAULT_GRAPH_EDGE_LIMIT=200
PAGERANK_ALPHA=0.85
PAGERANK_MAX_ITER=100
